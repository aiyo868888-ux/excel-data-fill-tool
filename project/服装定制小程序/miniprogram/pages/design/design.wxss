/* pages/design/design.wxss - 商品详情页样式 */

/* 页面容器 */
.page-container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding-bottom: 140rpx;
}

/* 自定义导航栏 */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #000000;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  z-index: 1000;
}

.navbar-back,
.navbar-share {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon,
.share-icon {
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 300;
}

.navbar-title {
  flex: 1;
  text-align: center;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
}

.navbar-placeholder {
  width: 100%;
}

/* 商品主图区域 */
.product-image-container {
  width: 100%;
  height: 750rpx;
  position: relative;
  background-color: #F5F5F5;
}

.product-image {
  width: 100%;
  height: 100%;
}

/* 图片序号指示器 */
.image-indicator {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
}

/* 图片操作栏 */
.image-action-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 30rpx 20rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #EEEEEE;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 30rpx;
}

.action-icon {
  font-size: 48rpx;
}

.action-text {
  font-size: 24rpx;
  color: #333333;
}

/* 商品信息框（黑色边框） */
.product-info-box {
  margin: 20rpx;
  padding: 30rpx;
  border: 2rpx solid #000000;
  background-color: #FFFFFF;
  border-radius: 8rpx;
}

.product-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #000000;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.product-specs {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.spec-row {
  display: flex;
  align-items: center;
  font-size: 28rpx;
}

.spec-label {
  color: #999999;
  width: 120rpx;
  flex-shrink: 0;
}

.spec-value {
  color: #333333;
  font-weight: 500;
}

/* 底部导航栏 */
.bottom-nav-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background-color: #FFFFFF;
  border-top: 1rpx solid #EEEEEE;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  gap: 20rpx;
  z-index: 999;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5rpx;
  flex: 1;
  padding: 10rpx 0;
}

.nav-icon {
  font-size: 44rpx;
}

.nav-text {
  font-size: 22rpx;
  color: #666666;
}

.design-btn {
  flex: 2;
  height: 80rpx;
  background-color: #FF6600;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.design-btn-text {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
}
