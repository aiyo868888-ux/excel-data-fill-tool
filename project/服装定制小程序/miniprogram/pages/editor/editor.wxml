<!--pages/editor/editor.wxml - 自助设计编辑页-->
<view class="container">
  <!-- 商品图片画布 -->
  <view class="canvas-area">
    <image class="canvas-background" src="{{productImage}}" mode="aspectFit" />

    <!-- 设计元素覆盖层 -->
    <view class="elements-layer">
      <view
        class="design-element {{selectedId === item.id ? 'selected' : ''}}"
        wx:for="{{elements}}"
        wx:key="id"
        style="left: {{item.x}}rpx; top: {{item.y}}rpx; width: {{item.width}}rpx; height: {{item.height}}rpx; transform: rotate({{item.rotation}}deg);"
        bindtap="onSelectElement"
        data-id="{{item.id}}"
      >
        <image wx:if="{{item.type === 'image'}}" class="element-image" src="{{item.url}}" mode="aspectFill" />
        <text wx:if="{{item.type === 'text'}}" class="element-text" style="font-size: {{item.fontSize}}rpx; color: {{item.color}};">{{item.content}}</text>
      </view>
    </view>

    <!-- 选中元素的操作按钮 -->
    <view class="element-actions" wx:if="{{selectedId}}">
      <view class="action-btn-small" bindtap="onDeleteElement">
        <text>删除</text>
      </view>
    </view>
  </view>

  <!-- 商品信息卡片 -->
  <view class="product-info-card">
    <!-- 价格和销量 -->
    <view class="price-row">
      <text class="price">¥{{productPrice}}</text>
      <text class="sales">已售{{productSales}}件</text>
    </view>

    <!-- 商品名称 -->
    <view class="product-name">{{productName}}</view>

    <!-- 商品规格 -->
    <view class="specs-section">
      <view class="spec-title">商品规格</view>
      <view class="specs-row">
        <view class="spec-item">
          <text class="spec-label">品类</text>
          <text class="spec-value">{{productType}}</text>
        </view>
        <view class="spec-item">
          <text class="spec-label">版型</text>
          <text class="spec-value">{{productStyle}}</text>
        </view>
        <view class="spec-item">
          <text class="spec-label">材质</text>
          <text class="spec-value">{{productMaterial}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 商品详情图片展示 -->
  <view class="detail-images-card">
    <view class="detail-title">商品详情</view>
    <view class="detail-images">
      <image
        wx:for="{{detailImages}}"
        wx:key="index"
        class="detail-image"
        src="{{item}}"
        mode="widthFix"
        lazy-load
      />
    </view>
  </view>

  <!-- 底部工具栏 -->
  <view class="bottom-toolbar">
    <view class="toolbar-item" bindtap="onUploadImage">
      <text class="toolbar-icon">📤</text>
      <text class="toolbar-text">上传图片</text>
    </view>
    <view class="toolbar-item" bindtap="onAddText">
      <text class="toolbar-icon">T</text>
      <text class="toolbar-text">添加文字</text>
    </view>
    <view class="toolbar-item primary" bindtap="onComplete">
      <text class="toolbar-icon">✓</text>
      <text class="toolbar-text">完成</text>
    </view>
  </view>
</view>
