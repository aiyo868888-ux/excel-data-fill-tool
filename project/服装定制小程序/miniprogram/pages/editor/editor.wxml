<!-- pages/editor/editor.wxml - 自助设计编辑页 -->
<view class="page-container">
  <!-- 自定义导航栏 -->
  <view class="custom-navbar" style="padding-top: {{statusBarHeight}}px; height: {{totalNavbarHeight}}px;">
    <view class="navbar-back" bindtap="onBack">
      <text class="back-icon">‹</text>
    </view>
    <view class="navbar-title">{{navigationBarTitle}}</view>
    <view class="navbar-placeholder"></view>
  </view>

  <!-- 导航栏占位符 -->
  <view class="navbar-placeholder" style="height: {{totalNavbarHeight}}px;"></view>

  <!-- 顶部工具栏 -->
  <view class="top-toolbar">
    <view class="toolbar-btn" bindtap="onChangeStyle">
      <text class="toolbar-btn-text">款式</text>
    </view>
    <view class="toolbar-btn" bindtap="onNewDesign">
      <text class="toolbar-btn-text">新建</text>
    </view>
    <view class="toolbar-btn" bindtap="onShowHelp">
      <text class="toolbar-btn-text">?</text>
    </view>
    <view class="toolbar-btn" bindtap="onSaveDesign">
      <text class="toolbar-btn-text">保存</text>
    </view>
    <view class="toolbar-btn marked">
      <text class="toolbar-btn-text">1</text>
    </view>
    <view class="toolbar-btn" bindtap="onEditDesign">
      <text class="toolbar-btn-text">编辑</text>
    </view>
  </view>

  <!-- 画布区域 -->
  <view class="canvas-area">
    <!-- 产品图背景 -->
    <image
      class="canvas-bg"
      src="{{productImage}}"
      mode="aspectFill"
      binderror="onImageError"
      bindload="onImageLoad"
      show-menu-by-longpress
    />

    <!-- 加载提示 -->
    <view wx:if="{{!productImage}}" class="loading-tip">
      <text>正在加载商品图片...</text>
    </view>

    <!-- 左侧颜色选择器 -->
    <view class="color-picker">
      <view
        class="color-item {{selectedColorIndex === index ? 'active' : ''}}"
        wx:for="{{colorList}}"
        wx:key="index"
        style="background-color: {{item.color}};"
        bindtap="onSelectColor"
        data-index="{{index}}"
        data-color="{{item.color}}"
        data-name="{{item.name}}"
      ></view>
    </view>

    <!-- 右侧颜色标签 -->
    <view class="color-label" wx:if="{{selectedColorName}}">
      <text class="label-text">当前颜色: {{selectedColorName}}</text>
    </view>

    <!-- 设计元素层 -->
    <view class="elements-layer">
      <view
        class="design-element {{selectedId === item.id ? 'selected' : ''}}"
        wx:for="{{elements}}"
        wx:key="id"
        style="left: {{item.x}}rpx; top: {{item.y}}rpx; width: {{item.width}}rpx; height: {{item.height}}rpx; transform: rotate({{item.rotation}}deg);"
        bindtap="onSelectElement"
        bindtouchstart="onElementTouchStart"
        bindtouchmove="onElementTouchMove"
        bindtouchend="onElementTouchEnd"
        data-id="{{item.id}}"
      >
        <image wx:if="{{item.type === 'image'}}" class="element-image" src="{{item.url}}" mode="aspectFill" />
        <text wx:if="{{item.type === 'text'}}" class="element-text" style="font-size: {{item.fontSize}}rpx; color: {{item.color}};">{{item.content}}</text>

        <!-- 选中时的控制按钮 -->
        <view wx:if="{{selectedId === item.id}}" class="element-controls">
          <!-- 删除按钮 -->
          <view class="control-btn delete-btn" catchtap="onDeleteElementTap" data-id="{{item.id}}">
            <text class="control-icon">×</text>
          </view>
          <!-- 缩放按钮 -->
          <view class="control-btn resize-btn" catchtouchstart="onResizeStart" catchtouchmove="onResizeMove" catchtouchend="onResizeEnd" data-id="{{item.id}}">
            <text class="control-icon">↔</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部工具栏 -->
  <view class="bottom-toolbar">
    <view class="toolbar-item" bindtap="onSelectMaterial">
      <text class="toolbar-icon">🎨</text>
      <text class="toolbar-text">素材</text>
    </view>
    <view class="toolbar-item" bindtap="onUploadImage">
      <text class="toolbar-icon">📤</text>
      <text class="toolbar-text">上传</text>
    </view>
    <view class="toolbar-item" bindtap="onAddText">
      <text class="toolbar-icon">T</text>
      <text class="toolbar-text">文字</text>
    </view>
    <view class="toolbar-item primary" bindtap="onComplete">
      <text class="toolbar-icon">✓</text>
      <text class="toolbar-text">完成</text>
    </view>
  </view>
</view>
