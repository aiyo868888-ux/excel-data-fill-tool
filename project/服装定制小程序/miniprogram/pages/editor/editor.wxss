/* pages/editor/editor.wxss - 自助设计编辑页样式 */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

/* 画布区域 */
.canvas-area {
  flex: 1;
  position: relative;
  background-color: white;
  overflow: hidden;
}

.canvas-background {
  width: 100%;
  height: 100%;
}

/* 元素层 */
.elements-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 设计元素 */
.design-element {
  position: absolute;
  border: 2rpx dashed transparent;
  transition: all 0.3s;
}

.design-element.selected {
  border-color: #E60012;
  background-color: rgba(230, 0, 18, 0.1);
}

.element-image {
  width: 100%;
  height: 100%;
}

.element-text {
  white-space: nowrap;
}

/* 元素操作按钮 */
.element-actions {
  position: absolute;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 100;
}

.action-btn-small {
  padding: 15rpx 40rpx;
  background-color: rgba(0, 0, 0, 0.8);
  color: white;
  border-radius: 30rpx;
  font-size: 28rpx;
}

/* 商品信息卡片 */
.product-info-card {
  background-color: white;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.price {
  font-size: 48rpx;
  font-weight: bold;
  color: #E60012;
}

.sales {
  font-size: 24rpx;
  color: #999;
}

.product-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  line-height: 1.4;
}

/* 商品规格 */
.specs-section {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.spec-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.specs-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.spec-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.spec-label {
  font-size: 24rpx;
  color: #999;
}

.spec-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 商品详情图片 */
.detail-images-card {
  background-color: white;
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.detail-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.detail-images {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.detail-image {
  width: 100%;
  display: block;
  border-radius: 8rpx;
}

/* 底部工具栏 */
.bottom-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 20rpx 0;
  background-color: black;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.toolbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 15rpx 30rpx;
  border-radius: 10rpx;
}

.toolbar-item.primary {
  background-color: #E60012;
  padding: 15rpx 40rpx;
}

.toolbar-icon {
  font-size: 40rpx;
}

.toolbar-text {
  font-size: 24rpx;
  color: white;
}
