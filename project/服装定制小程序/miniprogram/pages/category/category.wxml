<!--pages/category/category.wxml-->
<view class="container">
  <!-- 顶部搜索栏 -->
  <view class="search-header">
    <view class="search-box" bindtap="onSearch">
      <image class="search-icon" src="/images/icon-search.png" mode="aspectFit" />
      <input class="search-input" placeholder="搜索你想要的商品" bindconfirm="onSearchConfirm" />
    </view>
    <view class="filter-btn" bindtap="onFilter">
      <text>筛选</text>
      <image class="filter-icon" src="/images/icon-filter.png" mode="aspectFit" />
    </view>
  </view>

  <!-- 主内容区 -->
  <view class="main-content">
    <!-- 左侧分类导航 -->
    <scroll-view class="category-sidebar" scroll-y>
      <view
        class="category-item {{selectedCategoryId === item._id ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="_id"
        bindtap="onCategoryChange"
        data-id="{{item._id}}"
      >
        <image class="category-icon" src="{{item.icon}}" mode="aspectFit" />
        <text class="category-name">{{item.name}}</text>
      </view>
    </scroll-view>

    <!-- 右侧商品列表 -->
    <scroll-view class="product-list" scroll-y bindscrolltolower="onScrollToLower">
      <!-- 排序选项 -->
      <view class="sort-bar">
        <view
          class="sort-item {{sortBy === 'default' ? 'active' : ''}}"
          bindtap="onSortChange"
          data-sort="default"
        >
          <text>综合</text>
        </view>
        <view
          class="sort-item {{sortBy === 'sales' ? 'active' : ''}}"
          bindtap="onSortChange"
          data-sort="sales"
        >
          <text>销量</text>
        </view>
        <view
          class="sort-item {{sortBy === 'price' ? 'active' : ''}}"
          bindtap="onSortChange"
          data-sort="price"
        >
          <text>价格</text>
          <image class="sort-icon" src="/images/icon-sort.png" mode="aspectFit" />
        </view>
      </view>

      <!-- 商品卡片列表 -->
      <view class="product-items">
        <view
          class="product-card"
          wx:for="{{products}}"
          wx:key="_id"
          bindtap="onProductTap"
          data-id="{{item._id}}"
        >
          <image class="product-image" src="{{item.images[0]}}" mode="aspectFill" />
          <view class="product-info">
            <text class="product-name">{{item.name}}</text>
            <view class="product-attrs">
              <text class="attr-item">品类：{{item.type}}</text>
              <text class="attr-item">版型：{{item.style}}</text>
              <text class="attr-item">材质：{{item.material}}</text>
            </view>
            <view class="product-footer">
              <text class="product-price">¥{{item.price}}</text>
              <text class="product-sales">已售{{item.sales}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 加载状态 -->
      <view class="loading-more" wx:if="{{hasMore}}">
        <text>加载中...</text>
      </view>
      <view class="no-more" wx:elif="{{!hasMore && products.length > 0}}">
        <text>没有更多了</text>
      </view>

      <!-- 空状态 -->
      <view class="empty" wx:if="{{products.length === 0 && !loading}}">
        <image class="empty-icon" src="/images/empty.png" mode="aspectFit" />
        <text class="empty-text">暂无商品</text>
      </view>
    </scroll-view>
  </view>
</view>
