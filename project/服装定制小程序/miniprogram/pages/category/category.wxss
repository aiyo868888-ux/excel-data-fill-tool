/* pages/category/category.wxss */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 搜索头部 */
.search-header {
  display: flex;
  align-items: center;
  padding: 15rpx 20rpx;
  background-color: white;
  border-bottom: 1rpx solid var(--border-color);
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: var(--bg-gray);
  border-radius: 20rpx;
  padding: 10rpx 20rpx;
  margin-right: 20rpx;
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
}

.search-input {
  flex: 1;
  font-size: var(--font-size-base);
}

.filter-btn {
  display: flex;
  align-items: center;
  font-size: var(--font-size-base);
  color: var(--text-secondary);
}

.filter-icon {
  width: 28rpx;
  height: 28rpx;
  margin-left: 5rpx;
}

/* 主内容区 */
.main-content {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* 左侧分类导航 */
.category-sidebar {
  width: 180rpx;
  background-color: #f8f8f8;
  border-right: 1rpx solid var(--border-color);
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 10rpx;
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  border-left: 4rpx solid transparent;
  transition: all 0.3s;
}

.category-item .category-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
  margin-bottom: 10rpx;
}

.category-item .category-name {
  font-size: 22rpx;
  text-align: center;
}

.category-item.active {
  background-color: white;
  color: var(--primary-color);
  border-left-color: var(--primary-color);
  font-weight: var(--font-weight-medium);
}

.category-name {
  flex: 1;
}

.arrow {
  font-size: 12px;
  margin-left: 5rpx;
}

/* 右侧商品列表 */
.product-list {
  flex: 1;
  background-color: white;
}

/* 排序栏 */
.sort-bar {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.sort-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-base);
  color: var(--text-secondary);
  padding: 10rpx;
  border-radius: var(--radius-sm);
}

.sort-item.active {
  color: var(--primary-color);
  background-color: rgba(230, 0, 18, 0.1);
}

.sort-icon {
  width: 24rpx;
  height: 24rpx;
  margin-left: 5rpx;
}

/* 商品卡片列表 */
.product-items {
  padding: 20rpx;
}

.product-card {
  display: flex;
  padding: 20rpx;
  margin-bottom: 20rpx;
  background-color: white;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-color);
}

.product-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--radius-sm);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-medium);
  color: var(--text-primary);
  line-height: 1.4;
}

.product-attrs {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.attr-item {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
}

/* 加载状态 */
.loading-more,
.no-more {
  text-align: center;
  padding: 30rpx;
  font-size: var(--font-size-sm);
  color: var(--text-placeholder);
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: var(--font-size-base);
  color: var(--text-secondary);
}
