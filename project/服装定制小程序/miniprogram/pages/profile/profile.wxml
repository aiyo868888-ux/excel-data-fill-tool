<!--pages/profile/profile.wxml-->
<view class="container">
  <!-- 用户信息区 -->
  <view class="user-header">
    <view class="user-avatar-wrapper" bindtap="onChangeAvatar">
      <image class="user-avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
    </view>
    <view class="user-info">
      <text class="user-name">{{userInfo.nickName || '微信用户'}}</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-grid">
      <view class="menu-item" bindtap="onMyDesigns">
        <image class="menu-icon" src="/images/icon-design.png" mode="aspectFit" />
        <text class="menu-text">我的设计</text>
      </view>
      <view class="menu-item" bindtap="onProfile">
        <image class="menu-icon" src="/images/icon-profile.png" mode="aspectFit" />
        <text class="menu-text">个人资料</text>
      </view>
      <view class="menu-item" bindtap="onOriginal">
        <image class="menu-icon" src="/images/icon-original.png" mode="aspectFit" />
        <text class="menu-text">原创精品</text>
      </view>
      <view class="menu-item" bindtap="onFavorite">
        <image class="menu-icon" src="/images/icon-favorite.png" mode="aspectFit" />
        <text class="menu-text">我的收藏</text>
      </view>
    </view>
  </view>

  <!-- 辅助功能 -->
  <view class="list-section">
    <view class="list-item" bindtap="onHelp">
      <view class="list-item-left">
        <image class="list-icon" src="/images/icon-help.png" mode="aspectFit" />
        <text class="list-text">使用手册</text>
      </view>
      <image class="arrow-icon" src="/images/icon-arrow.png" mode="aspectFit" />
    </view>

    <view class="list-item">
      <view class="list-item-left">
        <image class="list-icon" src="/images/icon-guide.png" mode="aspectFit" />
        <text class="list-text">向导设置</text>
      </view>
      <switch checked="{{guideEnabled}}" bindchange="onGuideChange" color="#E60012" />
    </view>
  </view>
</view>
