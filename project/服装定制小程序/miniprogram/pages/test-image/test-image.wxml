<!--pages/test-image/test-image.wxml-->
<view class="container">
  <view class="header">
    <text class="title">云函数测试页面</text>
    <text class="status {{data.status.includes('成功') ? 'success' : data.status.includes('失败') ? 'error' : ''}}">
      {{data.status}}
    </text>
  </view>

  <view class="section">
    <text class="section-title">测试图片</text>
    <view class="image-container">
      <image
        src="{{data.testImage}}"
        mode="aspectFill"
        bindload="onImageLoad"
        binderror="onImageError"
        class="test-image"
      />
      <text class="image-hint">{{data.testImage ? '如果能看到图片，说明云函数工作正常 ✅' : '等待测试...'}}</text>
    </view>
  </view>

  <view class="section">
    <text class="section-title">日志</text>
    <scroll-view class="logs" scroll-y>
      <view class="log-item" wx:for="{{data.logs}}" wx:key="index">
        {{item}}
      </view>
    </scroll-view>
  </view>

  <view class="info">
    <text class="info-title">说明</text>
    <text class="info-text">1. 此页面用于测试云函数是否正常工作</text>
    <text class="info-text">2. 如果看到图片，说明体验用户可以看到云存储图片</text>
    <text class="info-text">3. 查看日志了解详细的调用过程</text>
  </view>
</view>
