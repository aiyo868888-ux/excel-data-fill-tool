/* pages/index/index.wxss */
.container {
  background-color: var(--bg-gray);
}

/* 搜索框 */
.search-bar {
  display: flex;
  align-items: center;
  background-color: white;
  border-radius: 20rpx;
  padding: 15rpx 30rpx;
  margin: 20rpx;
  box-shadow: var(--shadow-sm);
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 15rpx;
}

.search-placeholder {
  flex: 1;
  font-size: var(--font-size-base);
  color: var(--text-placeholder);
}

/* 轮播图 */
.banner-container {
  margin: 20rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-md);
}

.banner {
  width: 100%;
  height: 300rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* 分类区域 */
.category-section {
  background-color: white;
  margin: 20rpx;
  border-radius: var(--radius-lg);
  padding: 30rpx;
  box-shadow: var(--shadow-sm);
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
  margin-bottom: 30rpx;
  color: var(--text-primary);
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 15rpx;
  border-radius: var(--radius-md);
  transition: background-color 0.3s;
}

.category-item:active {
  background-color: var(--bg-gray);
}

.category-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-md);
  margin-bottom: 15rpx;
  background-color: var(--bg-gray);
}

.category-name {
  font-size: var(--font-size-sm);
  color: var(--text-primary);
  text-align: center;
}

/* 热门商品 */
.products-section {
  background-color: white;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: var(--radius-lg);
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: var(--font-weight-bold);
  margin-bottom: 30rpx;
  color: var(--text-primary);
}

.section-title .more {
  font-size: var(--font-size-base);
  color: var(--text-secondary);
  font-weight: var(--font-weight-normal);
}

.products-scroll {
  white-space: nowrap;
}

.product-scroll-item {
  display: inline-block;
  width: 200rpx;
  margin-right: 20rpx;
  text-align: center;
}

.product-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md);
  background-color: var(--bg-gray);
  margin-bottom: 15rpx;
}

.product-name-small {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 10rpx;
}

/* 新品上市 */
.new-products-section {
  background-color: white;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: var(--radius-lg);
}

.new-products-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.new-product-card {
  border-radius: var(--radius-md);
  overflow: hidden;
  background-color: var(--bg-gray);
}

.new-product-image {
  width: 100%;
  height: 250rpx;
}

.new-product-info {
  padding: 20rpx;
}

.new-product-name {
  display: block;
  font-size: var(--font-size-base);
  color: var(--text-primary);
  margin-bottom: 15rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.new-product-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.new-product-price {
  font-size: 28rpx;
  color: #E60012;
  font-weight: var(--font-weight-bold);
}

.new-product-sales {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
}

/* 服务优势 */
.services-section {
  background-color: white;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: var(--radius-lg);
  display: flex;
  justify-content: space-around;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.service-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 15rpx;
}

.service-title {
  font-size: var(--font-size-base);
  color: var(--text-primary);
  margin-bottom: 8rpx;
  font-weight: var(--font-weight-medium);
}

.service-desc {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
}
