/* pages/editor/editor.wxss - 自助设计编辑页样式 */

/* 页面容器 */
.page-container {
  min-height: 100vh;
  background-color: #F5F5F5;
  display: flex;
  flex-direction: column;
}

/* 自定义导航栏 */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #000000;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  z-index: 1000;
}

.navbar-back,
.navbar-placeholder {
  width: 60rpx;
}

.navbar-back {
  display: flex;
  align-items: center;
}

.back-icon {
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 300;
}

.navbar-title {
  flex: 1;
  text-align: center;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
}

.navbar-placeholder-view {
  width: 100%;
}

/* 顶部工具栏 */
.top-toolbar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #F5F5F5;
  gap: 15rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.toolbar-btn {
  padding: 15rpx 25rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #DDDDDD;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333333;
  flex-shrink: 0;
}

.toolbar-btn.marked {
  background-color: #FF6600;
  color: #FFFFFF;
  border-color: #FF6600;
}

/* 画布区域 */
.canvas-area {
  flex: 1;
  position: relative;
  display: flex;
  background-color: #FFFFFF;
  overflow: hidden;
}

.canvas-bg {
  width: 100%;
  height: 100%;
}

/* 颜色选择器 - 左侧 */
.color-picker {
  position: absolute;
  left: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  background-color: rgba(255, 255, 255, 0.95);
  padding: 20rpx 10rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.color-item {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
  transition: all 0.2s;
}

/* 白色特殊处理 */
.color-item[style*="#FFFFFF"] {
  border: 2rpx solid #E0E0E0;
}

.color-item.active {
  border-color: #FF6600;
  transform: scale(1.1);
  box-shadow: 0 4rpx 12rpx rgba(255, 102, 0, 0.4);
}

/* 颜色标签 - 右侧 */
.color-label {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  background-color: rgba(0, 0, 0, 0.7);
  color: #FFFFFF;
  padding: 15rpx 25rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  z-index: 100;
}

.label-text {
  color: #FFFFFF;
}

/* 元素层 */
.elements-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 设计元素 */
.design-element {
  position: absolute;
  border: 2rpx dashed transparent;
  transition: all 0.3s;
}

.design-element.selected {
  border-color: #FF6600;
  background-color: rgba(255, 102, 0, 0.1);
}

.element-image {
  width: 100%;
  height: 100%;
}

.element-text {
  white-space: nowrap;
}

/* 底部工具栏 */
.bottom-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 20rpx 0;
  background-color: #000000;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.toolbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 15rpx 30rpx;
}

.toolbar-item.primary {
  background-color: #FF6600;
  border-radius: 30rpx;
  padding: 15rpx 40rpx;
}

.toolbar-icon {
  font-size: 44rpx;
}

.toolbar-text {
  font-size: 24rpx;
  color: #FFFFFF;
}
