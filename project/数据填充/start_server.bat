@echo off
echo ================================================================================
echo 正在清理旧进程...
echo ================================================================================

REM 清理所有占用8888端口的进程
for /f "tokens=5" %%a in ('netstat -ano ^| findstr :8888 ^| findstr LISTENING') do (
    echo 终止进程: %%a
    taskkill /F /PID %%a >nul 2>&1
)

timeout /t 2 /nobreak >nul

echo ================================================================================
echo 启动数据填充工具Web服务器
echo 访问地址: http://localhost:8888
echo 按 Ctrl+C 停止服务器
echo ================================================================================
echo.

cd /d "%~dp0"
python web_app.py

pause
