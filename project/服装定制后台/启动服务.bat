@echo off
chcp 65001 >nul
echo ╔══════════════════════════════════════════════════════════════╗
echo ║           启动后台管理系统                                   ║
echo ╚══════════════════════════════════════════════════════════════╝
echo.

echo [1/2] 构建前端...
cd admin
call npm run build
if %errorlevel% neq 0 (
    echo ❌ 前端构建失败
    pause
    exit /b 1
)
echo ✅ 前端构建完成

echo.
echo [2/2] 启动后端服务...
cd ..\server
echo.
echo ╔══════════════════════════════════════════════════════════════╗
echo ║                  服务启动中...                               ║
echo ╠══════════════════════════════════════════════════════════════╣
echo ║  访问地址: http://localhost:3000                            ║
echo ║  按 Ctrl+C 停止服务                                         ║
echo ╚══════════════════════════════════════════════════════════════╝
echo.
call npm start
