<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/tagContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- 层级缩进指示器 -->
        <View
            android:id="@+id/indentIndicator"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginEnd="8dp" />

        <!-- 颜色指示器 -->
        <View
            android:id="@+id/colorIndicator"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/tag_color_circle"
            android:backgroundTint="#4ECDC4" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 父标签显示（如果有） -->
            <TextView
                android:id="@+id/parentTagName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_hint"
                android:visibility="gone"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tagName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="工作"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tagUsage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="使用 5 次"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <!-- 编辑按钮 -->
        <TextView
            android:id="@+id/btnEdit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="✎"
            android:textSize="20sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="编辑标签" />

        <!-- 删除按钮 -->
        <TextView
            android:id="@+id/btnDelete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="🗑"
            android:textSize="20sp"
            android:textColor="@color/error"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="删除标签" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
